PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
FRONTEND_ORIGIN=http://localhost:5173

# Turso (libSQL) - required for Vercel deployment / persistent database
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: local SQLite file path for dev when not using Turso
# SQLITE_PATH=server/data/awo.sqlite
# Leave empty to use the same-origin Vite /api proxy in development.
# VITE_API_URL=
