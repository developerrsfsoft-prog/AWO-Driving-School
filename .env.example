PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
FRONTEND_ORIGIN=http://localhost:5173

# Configure both Turso values for Vercel. Leave them empty for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for persistent production media uploads.
BLOB_READ_WRITE_TOKEN=

# Optional local-only paths.
# SQLITE_PATH=server/data/awo.sqlite
# UPLOADS_DIR=wwwroot/uploads
# VITE_API_URL=
