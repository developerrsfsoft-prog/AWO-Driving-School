{
  "name": "awo-driving-school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:import": "tsx scripts/migrate-sqlite-to-turso.ts",
    "db:verify": "tsx scripts/verify-turso.ts",
    "media:migrate": "tsx scripts/migrate-uploads-to-blob.ts",
    "test:api": "tsx scripts/run-api-tests.ts",
    "precheck": "tsx scripts/pre-deployment-check.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/nodemailer": "^8.0.2",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.2.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
